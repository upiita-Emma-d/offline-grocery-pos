# Copy to .env (next to manage.py) and adjust. .env is never committed.
# The install scripts in scripts/ create it for you.

# Required in production: a long random string (the install script generates one).
POS_SECRET_KEY=change-me-to-a-long-random-string
# 0 = production (waitress), 1 = development (runserver, detailed errors).
POS_DEBUG=0
# Hosts allowed to open the POS: this computer plus its LAN IP so phones can connect.
POS_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50
# Port used by the start scripts (waitress).
POS_PORT=8008
# Where the database, backups and photos live. Defaults to ./data
# POS_DATA_DIR=C:\TiendaPOS\data
# Extra backup destination (ideally a USB drive or another disk). Defaults to ./data/backups
# POS_BACKUP_DIR=D:\TiendaPOS-backups
# POS_TIME_ZONE=America/Mexico_City

# Network thermal printer (Epson TM series, ESC/POS over TCP). Leave the host empty to print from the browser.
POS_PRINTER_HOST=
POS_PRINTER_PORT=9100
# 42 for 80 mm paper (Font A), 32 for 58 mm.
POS_PRINTER_COLUMNS=42
# 1 = print accents and ñ using code page Windows-1252 (supported by the Epson TM-T88V; confirm with test_printer).
POS_PRINTER_ACCENTS=0
